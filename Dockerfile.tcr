ARG APP_PATH=/opt/outline

# TCR native builds use one self-contained Dockerfile to avoid an external base-image handoff.
FROM node:26.3.0 AS build

ARG APP_PATH
WORKDIR $APP_PATH

COPY ./package.json ./yarn.lock ./.yarnrc.yml ./
COPY ./patches ./patches

RUN sed -i 's|http://deb.debian.org/debian|https://mirrors.tencent.com/debian|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_OPTIONS="--max-old-space-size=24000"

RUN npm install --global --registry=https://mirrors.tencent.com/npm corepack@0.35.0 \
    && corepack enable
RUN yarn install --immutable --network-timeout 1000000 && \
  yarn cache clean

COPY . .
ARG CDN_URL
RUN yarn build

RUN yarn workspaces focus --production && \
  yarn cache clean

FROM node:26.3.0-slim AS runner

LABEL org.opencontainers.image.source="https://github.com/primatrix/outline"

ARG APP_PATH
WORKDIR $APP_PATH
ENV NODE_ENV=production

RUN addgroup --gid 1001 nodejs && \
    adduser --uid 1001 --ingroup nodejs nodejs && \
    mkdir -p /var/lib/outline && \
    chown -R nodejs:nodejs /var/lib/outline && \
    chown -R nodejs:nodejs $APP_PATH

COPY --from=build --chown=nodejs:nodejs $APP_PATH/build ./build
COPY --from=build --chown=nodejs:nodejs $APP_PATH/server ./server
COPY --from=build --chown=nodejs:nodejs $APP_PATH/public ./public
COPY --from=build --chown=nodejs:nodejs $APP_PATH/.sequelizerc ./.sequelizerc
COPY --from=build --chown=nodejs:nodejs $APP_PATH/node_modules ./node_modules
COPY --from=build --chown=nodejs:nodejs $APP_PATH/package.json ./package.json

ENV FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
RUN mkdir -p "$FILE_STORAGE_LOCAL_ROOT_DIR" && \
    chown -R nodejs:nodejs "$FILE_STORAGE_LOCAL_ROOT_DIR" && \
    chmod 1777 "$FILE_STORAGE_LOCAL_ROOT_DIR"

VOLUME /var/lib/outline/data

USER nodejs

HEALTHCHECK --interval=1m CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3000) + '/_health').then(response => response.text()).then(body => { if (!body.includes('OK')) process.exit(1); }).catch(() => process.exit(1))"

EXPOSE 3000
CMD ["node", "build/server/index.js"]
